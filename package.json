{
  "name": "brisa-chat",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm run typecheck && npm test",
    "server:dev": "tsx watch server/src/app.ts",
    "server:build": "tsc -p server/tsconfig.json",
    "server:start": "node server/dist/server/src/app.js",
    "test:integration": "firebase emulators:exec --project demo-brisa --only auth,firestore,database \"tsx --test tests/integration/*.test.ts\"",
    "format": "prettier --write App.tsx app.config.ts src shared server/src tests scripts",
    "format:check": "prettier --check App.tsx app.config.ts src shared server/src tests scripts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.0",
    "@expo/vector-icons": "^15.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/messaging": "^26.4.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "expo": "~55.0.31",
    "expo-build-properties": "~55.0.0",
    "expo-crypto": "~55.0.0",
    "expo-dev-client": "~55.0.0",
    "expo-image-picker": "~55.0.0",
    "expo-linear-gradient": "~55.0.0",
    "expo-notifications": "~55.0.0",
    "expo-status-bar": "~55.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "firebase": "^12.0.0",
    "firebase-admin": "^13.0.0",
    "helmet": "^8.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "firebase-tools": "^15.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  }
}
