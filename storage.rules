rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /photos/{uid}/{photoId} {
      allow read: if request.auth != null && request.auth.token.firebase.sign_in_provider == 'password';
      allow create: if request.auth != null && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.uid == uid && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update, delete: if false;
    }
  }
}
